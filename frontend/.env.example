# Copy to .env.local to point a local frontend at a local backend.
# Without these, the frontend talks to production (zetamaxx-server.onrender.com).

# Where Next.js proxies /api/* (server-side, read at build/start). No trailing slash.
BACKEND_URL=http://localhost:3001
# Where the browser opens the game WebSocket.
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
